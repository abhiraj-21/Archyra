# Copy to .env (git-ignored) and fill in. Run the app from backend/ so this file is found.

# --- Databases (required) ---
DB_USERNAME=
DB_PASSWORD=
NEO4J_PASSWORD=
#NEO4J_URI=bolt://localhost:7687
#NEO4J_USERNAME=neo4j

# --- Usage limits (required): lifetime allowances for FREE users; PREMIUM is never capped ---
ANALYSIS_LIMIT=5
AI_LIMIT=20

# --- Security (required) ---
# base64 of >= 32 random bytes:  openssl rand -base64 32
JWT_SECRET=
#JWT_ISSUER=archyra
# Local development over plain HTTP only. Refused when the prod profile is active.
#COOKIE_SECURE=false
#FRONTEND_BASE_URL=http://localhost:5173
#CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- OAuth2 login (required to start; register {API_BASE_URL}/login/oauth2/code/google and /github) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Ask AI (optional: chat needs at least one provider in the chain; indexing needs none) ---
# A chain of free providers, tried in this order. A provider with no key is simply not used. Every limit and model id is in
# application.properties (archyra.ai.providers.<id>.*); the variables below are the keys and the most useful overrides.
#AI_PROVIDER_ORDER=gemini,groq,openrouter,cloudflare,zai,cohere,ovh,llm7
# Gemini: free key in Google AI Studio, https://aistudio.google.com/apikey (free-tier prompts may be used by Google)
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.6-flash
# Groq: free key at https://console.groq.com/keys
#GROQ_API_KEY=
#GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter: https://openrouter.ai/keys. The model MUST end in :free (startup refuses anything else)
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Cloudflare Workers AI: an API token (Workers AI template) from https://dash.cloudflare.com/profile/api-tokens and your account id
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=
# Z AI (international endpoint): https://z.ai/manage-apikey/apikey-list
#ZAI_API_KEY=
# Cohere trial key: https://dashboard.cohere.com/api-keys (NON-COMMERCIAL USE ONLY)
#COHERE_API_KEY=
# LLM7: free token at https://token.llm7.io (or https://dash.llm7.io)
#LLM7_API_KEY=
# OVHcloud AI Endpoints needs no key: it is used anonymously (2 requests/min). It is on by default; false removes it.
#OVH_ENABLED=true
# Opt-in providers, OFF unless enabled. Read their data policies first (see README -> Ask AI).
#NVIDIA_NIM_ENABLED=false
#NVIDIA_NIM_API_KEY=
#KILO_ENABLED=false
#GONKA_ENABLED=false
#GONKA_API_KEY=
# Where the local embedding model is cached (git-ignored); fetch it once with scripts/fetch-embedding-model.sh
#EMBEDDING_CACHE_DIR=models

# --- Mail (defaults point at a local SMTP sink such as MailHog on 1025) ---
#SMTP_HOST=localhost
#SMTP_PORT=1025
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_AUTH=false
#SMTP_STARTTLS=false
#MAIL_FROM=no-reply@archyra.local


# --- Optional first administrator (created only if no admin exists) ---
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
