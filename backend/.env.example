# Copy to .env (git-ignored) and fill in. Run the app from backend/ so this file is found.

# --- Databases (required) ---
DB_USERNAME=
DB_PASSWORD=
NEO4J_PASSWORD=
#NEO4J_URI=bolt://localhost:7687
#NEO4J_USERNAME=neo4j

# --- Usage limits (required): lifetime allowances for FREE users; PREMIUM is never capped ---
ANALYSIS_LIMIT=5
AI_LIMIT=20

# --- Security (required) ---
# base64 of >= 32 random bytes:  openssl rand -base64 32
JWT_SECRET=
#JWT_ISSUER=archyra
# Local development over plain HTTP only. Refused when the prod profile is active.
#COOKIE_SECURE=false
#FRONTEND_BASE_URL=http://localhost:5173
#CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- OAuth2 login (required to start; register {API_BASE_URL}/login/oauth2/code/google and /github) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Ask AI (optional: chat needs at least one key; indexing needs none) ---
# Gemini (primary): create a free key in Google AI Studio, https://aistudio.google.com/apikey
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.6-flash
# Groq (fallback on 429 / 5xx / timeout): create a free key at https://console.groq.com/keys
#GROQ_API_KEY=
#GROQ_MODEL=openai/gpt-oss-120b
# Where the local embedding model is cached (git-ignored); fetch it once with scripts/fetch-embedding-model.sh
#EMBEDDING_CACHE_DIR=models

# --- Mail (defaults point at a local SMTP sink such as MailHog on 1025) ---
#SMTP_HOST=localhost
#SMTP_PORT=1025
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_AUTH=false
#SMTP_STARTTLS=false
#MAIL_FROM=no-reply@archyra.local


# --- Optional first administrator (created only if no admin exists) ---
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
