# Vite reads only VITE_* variables, and they ship to the browser: never put a secret in one.

# Where the Vite dev/preview proxy sends /api, /oauth2 and /login/oauth2. The browser itself only uses relative URLs.
VITE_BACKEND_ORIGIN=http://localhost:8080

# --- Not read by the app. Used only by scripts/capture (asset capture) and scripts/e2e (end-to-end tests).
# Put real values in an untracked .env.local; never commit them. Use dedicated test accounts, never a real person's.
ARCHYRA_APP_URL=http://localhost:5173
ARCHYRA_TEST_EMAIL=
ARCHYRA_TEST_PASSWORD=
# An ADMIN test account, used only by the e2e admin-gating check. Never captured in assets.
ARCHYRA_ADMIN_EMAIL=
ARCHYRA_ADMIN_PASSWORD=
# A public GitHub repository analysed for captures and e2e.
ARCHYRA_CAPTURE_REPO=https://github.com/spring-projects/spring-petclinic
# scripts/e2e/billing.spec.ts: the seeded-plan tests write the test account's plan row straight into the development database
# through `docker exec <container> psql` (no test endpoint). Opt-in: set the container name (e.g. archyra-postgres).
ARCHYRA_E2E_DB_CONTAINER=
#ARCHYRA_E2E_DB_USER=postgres
#ARCHYRA_E2E_DB_NAME=archyra
